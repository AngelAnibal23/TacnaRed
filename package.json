{
  "name": "tacnared-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "test": "node --test tests/domain.test.ts tests/api.test.ts tests/progress.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:theme": "node tests/theme.e2e.mjs",
    "test:closure": "node tests/closure.e2e.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "fastify": "5.12.5",
    "@fastify/static": "10.1.5",
    "@fastify/cookie": "^11.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "playwright": "1.62.1"
  }
}
